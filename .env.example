# Владелец схемы: миграции, сиды, BYPASSRLS. Приложение под ним НЕ работает.
MIGRATION_DATABASE_URL=postgres://crm_owner:crm_owner@localhost:5434/crm
# Логин-роль приложения: член crm_app, без BYPASSRLS — все запросы проходят через RLS.
DATABASE_URL=postgres://crm_app_user:crm_app_user@localhost:5434/crm
REDIS_URL=redis://localhost:6380

# API
JWT_SECRET=change-me-to-a-long-random-string-32+
CORS_ORIGIN=http://localhost:3000
# Ключ шифрования секретов каналов (32 байта, base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# Worker
TELEGRAM_API_URL=https://api.telegram.org

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
